{
  "schema": "verifiable.capabilities/1",
  "typescript": {
    "implementation": "scripts/*.ts",
    "setup": "references/typescript/setup.md",
    "commands": { "paths": "supported", "coverage": "supported", "mutation": "supported", "prune": "supported", "init": "instructions" },
    "shapes": ["decision", "classifier", "adapter", "wiring", "conversion"],
    "runners": ["node:test", "vitest"],
    "limits": ["Admission vocabularies and toolchain requirements apply", "mutation.ts was not run on Stryker.NET reports"]
  },
  "csharp": {
    "implementation": "scripts/dotnet/Verifiable.csproj",
    "setup": "references/csharp/setup.md",
    "commands": { "paths": "restricted", "coverage": "partial", "mutation": "unsupported", "prune": "unsupported", "init": "instructions" },
    "shapes": ["decision:boolean", "decision:enum", "decision:record"],
    "runners": ["standalone compiled-method runner"],
    "limits": ["One standalone file, all methods admitted or the file is rejected", "No MSBuild project loading or application assembly execution", "No existing-suite reconciliation or library contracts", "Not the complete coverage workflow"]
  }
}
